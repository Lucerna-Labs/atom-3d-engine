    {
      "name": "EMU10K1_FX8010_PCM_COUNT",
      "value": "8",
      "comment": "",
      "category": ""
    },
    {
      "name": "iMAC0",
      "value": "0x00",
      "comment": "R = A + (X * Y >> 31)   ; saturation",
      "category": ""
    },
    {
      "name": "iMAC1",
      "value": "0x01",
      "comment": "R = A + (-X * Y >> 31)  ; saturation",
      "category": ""
    },
    {
      "name": "iMAC2",
      "value": "0x02",
      "comment": "R = A + (X * Y >> 31)   ; wraparound",
      "category": ""
    },
    {
      "name": "iMAC3",
      "value": "0x03",
      "comment": "R = A + (-X * Y >> 31)  ; wraparound",
      "category": ""
    },
    {
      "name": "iMACINT0",
      "value": "0x04",
      "comment": "R = A + X * Y\t   ; saturation",
      "category": ""
    },
    {
      "name": "iMACINT1",
      "value": "0x05",
      "comment": "R = A + X * Y\t   ; wraparound (31-bit)",
      "category": ""
    },
    {
      "name": "iACC3",
      "value": "0x06",
      "comment": "R = A + X + Y\t   ; saturation",
      "category": ""
    },
    {
      "name": "iMACMV",
      "value": "0x07",
      "comment": "R = A, acc += X * Y >> 31",
      "category": ""
    },
    {
      "name": "iANDXOR",
      "value": "0x08",
      "comment": "R = (A & X) ^ Y",
      "category": ""
    },
    {
      "name": "iTSTNEG",
      "value": "0x09",
      "comment": "R = (A >= Y) ? X : ~X",
      "category": ""
    },
    {
      "name": "iLIMITGE",
      "value": "0x0a",
      "comment": "R = (A >= Y) ? X : Y",
      "category": ""
    },
    {
      "name": "iLIMITLT",
      "value": "0x0b",
      "comment": "R = (A < Y) ? X : Y",
      "category": ""
    },
    {
      "name": "iLOG",
      "value": "0x0c",
      "comment": "R = linear_data, A (log_data), X (max_exp), Y (format_word)",
      "category": ""
    },
    {
      "name": "iEXP",
      "value": "0x0d",
      "comment": "R = log_data, A (linear_data), X (max_exp), Y (format_word)",
      "category": ""
    },
    {
      "name": "iINTERP",
      "value": "0x0e",
      "comment": "R = A + (X * (Y - A) >> 31)  ; saturation",
      "category": ""
    },
    {
      "name": "iSKIP",
      "value": "0x0f",
      "comment": "R = A (cc_reg), X (count), Y (cc_test)",
      "category": ""
    },
