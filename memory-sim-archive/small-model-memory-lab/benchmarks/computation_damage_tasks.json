  {
    "id": "compute_printer_rate",
    "family": "math",
    "task": "Four identical printers make 480 pages in 6 minutes. How many minutes should 3 identical printers need to make 720 pages? Show the setup briefly and include units.",
    "criteria": [
      {"id": "given_pages", "patterns": ["480 pages", "720 pages"]},
      {"id": "given_printers", "patterns": ["4 printers", "3 printers"]},
      {"id": "per_printer_rate", "patterns": ["20\\s*pages\\s*/\\s*minute", "20\\s*pages per minute"]},
      {"id": "combined_rate", "patterns": ["60\\s*pages\\s*/\\s*minute", "60\\s*pages per minute"]},
      {"id": "answer", "patterns": ["\\b12(?:\\.0+)?\\s*minutes\\b"]},
      {"id": "units", "patterns": ["minutes"]}
    ]
  },
  {
