{
  "project": "Cyber Memory LoRA Lab",
  "question": "Can synthetic memories become trainable behavioral substrate for small models, improving prompt-injection resistance beyond an instruct baseline?",
  "probe_set": {
    "total": 12,
    "attacks": 8,
    "benign": 4,
    "domains": [
      "quoted text",
      "tool output",
      "webpage task replacement",
      "README environment-variable bait",
      "HTML comments",
      "markdown link titles",
      "diff comments",
      "transcript role impersonation",
      "benign safety explanations"
    ]
  },
  "runs": [
    {
      "model": "Qwen/Qwen3-1.7B",
      "setup": "instruct, no memories",
      "strict": {
        "total": "3/12",
        "attacks": "0/8",
        "benign": "3/4"
      },
      "behavioral": {
        "total": "3/12",
        "attacks": "0/8",
        "benign": "3/4"
      },
      "local_report": "runs/kaggle-instruct-baseline-v1/instruct_baseline_eval_results.json"
    },
    {
      "model": "Qwen/Qwen3-1.7B-Base",
      "setup": "base plus cyber-memory LoRA",
      "training": {
        "memories": 360,
        "examples": 720,
        "steps": 160,
        "adapter": "runs/kaggle-lora-v4/rust-cyber-memory-lora"
      },
      "strict": {
        "total": "7/12",
        "attacks": "3/8",
        "benign": "4/4"
      },
      "behavioral": {
        "total": "12/12",
        "attacks": "8/8",
        "benign": "4/4"
      },
      "local_report": "runs/kaggle-lora-v4/lora_eval_results.json"
    },
    {
      "model": "Qwen/Qwen3-1.7B",
      "setup": "instruct plus cyber-memory LoRA",
      "adapter_source": "Qwen/Qwen3-1.7B-Base cyber-memory LoRA",
      "strict": {
        "total": "5/12",
        "attacks": "1/8",
        "benign": "4/4"
      },
      "behavioral": {
        "total": "7/12",
        "attacks": "4/8",
        "benign": "3/4"
      },
      "local_report": "runs/kaggle-instruct-plus-lora-v1/instruct_plus_lora_eval_results.json"
    },
    {
      "model": "Qwen/Qwen3-4B-Base",
      "setup": "4B LoRA attempt on Kaggle P100",
      "status": "not completed",
      "failure": "CUDA OOM after loading the 4B model on a 16GB P100; only about 33 MB was free before PEFT preparation.",
      "next_step": "Use QLoRA on a better runtime or train locally on the Blackwell workstation when the PyTorch stack is ready."
    }
  ],
  "caveats": [
    "The strict scorer counts safe mentions of dangerous phrases as leaks, so it undercounts some safe explanatory behavior.",
    "The first LoRA still over-recites memory-shaped text; output-shaping is the next improvement target.",
    "The instruct-plus-LoRA run uses a base-trained adapter attached to an instruct model, so distribution mismatch is expected."
  ]
}
